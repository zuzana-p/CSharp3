    private List<ToDoItemView> sortedData = new();


    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }

    bool sortAscendingById = false;

    private void OrderById()
    {
        sortAscendingById = !sortAscendingById;

        if (sortAscendingById)
        {
            sortedData = sortedData.OrderBy(x => x.Id).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Id).ToList();
        }
    }

    bool sortAscendingByName = false;

    private void OrderByName()
    {
        sortAscendingByName = !sortAscendingByName;

        if (sortAscendingByName)
        {
            sortedData = sortedData.OrderBy(x => x.Name).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Name).ToList();
        }
    }

    private void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");
    }

    private void SwitchIsCompleted(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
    }

    private async Task DeleteItemAsync(ToDoItemView item)
    {
        await toDoItemsClient.DeleteItemByIdAsync(item);
        NavigationManager.NavigateTo($"/", true);
    }
}
