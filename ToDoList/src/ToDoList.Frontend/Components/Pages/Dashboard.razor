@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS



<!-- Table -->
<div>
    <h2 class="text-center mt-4 text-secondary align-items-center">TODO ITEMS DASHBOARD</h2>
    <table class="table table-hover mt-3 align-middle">
        <thead class="table-dark align-middle">
            <tr>
                <th></th>
                <th>
                    <SortButton Ascending="@sortAscendingById" OnClick="OrderById" />
                    id
                </th>
                <th>
                    <SortButton Ascending="@sortAscendingByName" OnClick="OrderByName" />
                    name
                </th>
                <th>description</th>
                <th>
                    <SortButton Ascending="@sortAscendingByCategory" OnClick="OrderByCategory" />
                    category
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-secondary">
                    <td class="text-left"><button class="btn btn-outline-success" @onclick="() => SwitchIsCompleted(item)">
                            @(item.IsCompleted ?
                                                    (MarkupString)"<i class=\"bi bi-check-circle-fill\"></i>" :
                                                    (MarkupString)"<i class=\"bi bi-circle\"></i>")
                        </button></td>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Category</td>
                    <td class="text-end"><button class="btn btn-outline-success" @onclick="() => EditItem(item)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger" @onclick="() => DeleteItemAsync(item)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<ConfirmDeleteModal CurrentItem=@currentItem OnClick="() => DeleteItemAsync(currentItem)" />





@code {
    private List<ToDoItemView> sortedData = new();
    private ToDoItemView? currentItem;
    bool sortAscendingById = false;
    bool sortAscendingByName = false;
    bool sortAscendingByCategory = false;

    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }

    private void OrderById()
    {
        sortAscendingById = !sortAscendingById;

        if (sortAscendingById)
        {
            sortedData = sortedData.OrderBy(x => x.Id).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Id).ToList();
        }
    }

    private void OrderByName()
    {
        sortAscendingByName = !sortAscendingByName;

        if (sortAscendingByName)
        {
            sortedData = sortedData.OrderBy(x => x.Name).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Name).ToList();
        }
    }

    private void OrderByCategory()
    {
        sortAscendingByCategory = !sortAscendingByCategory;

        if (sortAscendingByCategory)
        {
            sortedData = sortedData.OrderBy(x => x.Category).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Category).ToList();
        }
    }

    private void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");
    }

    private async Task SwitchIsCompleted(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
        await toDoItemsClient.UpdateItemAsync(item);
    }

    private async Task DeleteItemAsync(ToDoItemView item)
    {
        await toDoItemsClient.DeleteItemByIdAsync(item);
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }
}
