@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient;
@inject NavigationManager NavigationManager

<div>
    <h2>ToDo Items Dashboard</h2>
    <table class="table table-hover mt-3 align-middle">
        <thead class="table-dark align-middle">
            <tr>
                <th>
                    ID
                    <SortButton Ascending="@sortAscendingById" OnClick="OrderById" />
                </th>
                <th>
                    NAME
                    <SortButton Ascending="@sortAscendingByName" OnClick="OrderByName" />
                </th>
                <th>DESCRIPTION</th>
                <th>Actions</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-secondary">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td><button class="btn btn-outline-success" @onclick="() => EditItem(item)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger" @onclick="() => DeleteItemAsync(item)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                    <td><button class="btn btn-outline-success no-focus" @onclick="() => SwitchIsCompleted(item)">
                            @(item.IsCompleted ?
                                                    (MarkupString)"<i class=\"bi bi-circle\"></i>" :
                                                    (MarkupString)"<i class=\"bi bi-check-circle-fill\"></i>")
                        </button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

