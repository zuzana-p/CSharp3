@using ToDoList.Frontend.Models

<div>
    <h2>ToDo Items Dashboard</h2>
    <table>
        <thead>
            <tr>
                <th>
                    ID
                    <button @onclick="OrderById">⇅</button>
                </th>
                <th>
                    NAME
                    <button @onclick="OrderByName">⇅</button>
                </th>
                <th>DESCRIPTION</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "☑" : "☐")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    table {
        text-align: left;
        border-collapse: collapse;
    }

    th {
        background-color: #469b90;
        font-weight: bold;
    }

    td,
    th {
        border-bottom: 1px solid rgb(116, 109, 109);
        padding: 12px 16px;
    }

    tr:hover td {
        background-color: #f0da5d;
    }

    tr:last-child td {
        border-bottom: none;
    }

    th button {
        border: 0.5px solid rgb(116, 109, 109);
        background: transparent;
        cursor: pointer;
        font-size: 14px;
        padding: 0 4px;
    }

    th button:hover {
        background-color: #f0da5d;
    }
</style>

@code {
    private List<ToDoItemView> testData = new()
{
new ToDoItemView(1, "Nakoupit potraviny", "Mléko, chléb, vejce", false),
new ToDoItemView(2, "Dokončit projekt", "Implementovat všechny funkce", true),
new ToDoItemView(3, "Zavolat mamince", "Domluvit víkend", false),
new ToDoItemView(4, "Cvičit", "Běhání v parku", false),
new ToDoItemView(5, "Přečíst knihu", "Kapitola 5", true)
};

    private List<ToDoItemView> sortedData = new();

    protected override void OnInitialized()
    {
        sortedData = testData.ToList();
    }

    bool sortAscendingById = false;

    private void OrderById()
    {
        sortAscendingById = !sortAscendingById;

        if (sortAscendingById)
        {
            sortedData = sortedData.OrderBy(x => x.Id).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Id).ToList();
        }
    }

    bool sortAscendingByName = false;

    private void OrderByName()
    {
        sortAscendingByName = !sortAscendingByName;

        if (sortAscendingByName)
        {
            sortedData = sortedData.OrderBy(x => x.Name).ToList();
        }
        else
        {
            sortedData = sortedData.OrderByDescending(x => x.Name).ToList();
        }
    }
}
